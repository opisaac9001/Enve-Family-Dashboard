PORT=4317
HOST=127.0.0.1
# Optional bootstrap key for first setup over the network (at least 12 characters).
# Keep this private. After setup, household sign-ins control dashboard access.
ACCESS_KEY=
# Create a Google OAuth web application with this exact redirect URI:
# http://localhost:4317/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional after moving the server behind a private HTTPS address. Register the same URL in Google Cloud.
# GOOGLE_REDIRECT_URI=https://your-family-host.example/api/google/callback
# Create a Microsoft Entra web app registration accepting personal and work accounts.
# Add this exact web redirect URI: http://localhost:4317/api/outlook/callback
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
# Optional. Enables cloud meal ideas; built-in ideas work without this.
OPENAI_API_KEY=
# OPENAI_MEAL_MODEL=gpt-6-luna
