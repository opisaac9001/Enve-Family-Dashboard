[Unit]
Description=Enve Family calendar server
After=network.target

[Service]
Type=simple
User=REPLACE_USER
Group=REPLACE_USER
WorkingDirectory=REPLACE_ROOT
Environment=HOST=0.0.0.0
Environment=PORT=4317
Environment=DATABASE_PATH=REPLACE_ROOT/data/family.sqlite
Environment=ENVE_DEVICE_KEY_PATH=REPLACE_ROOT/data/.device-key
EnvironmentFile=-REPLACE_ROOT/.env
ExecStart=/usr/bin/node REPLACE_ROOT/server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
